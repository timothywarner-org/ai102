# =============================================================================
# AI-103 Lesson 10 -- Build agents by using Foundry
# Demo: m10_tools_repl.py (tool schemas, function calling, stop codes)
#
# Copy to .env and fill in your values:   cp .env.example .env
#
# Keyless: sign in with `az login`. No API keys anywhere in this lesson.
# The demo authenticates with AzureCliCredential, which uses that az identity.
# =============================================================================

# Foundry portal -> your project -> Overview -> Endpoint (the "Foundry API" one).
# Shape: https://<account>.services.ai.azure.com/api/projects/<project>
#
# Rebuilding from scratch? This lesson shares its environment with Lesson 11.
# infra/ai103-lesson-env.bicep stands up the account, project, and model, and
# prints both values below:
#
#   az group create -n rg-ai103-mvp -l eastus2
#   az deployment group create -g rg-ai103-mvp -n lesson-11 \
#     -f ../../infra/ai103-lesson-env.bicep \
#     -p userObjectId=$(az ad signed-in-user show --query id -o tsv) \
#        projectName=proj-agents baseName=ai103-l11
#
# The account name is generated from the resource group ID, so it differs per rebuild.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/proj-agents

# The model DEPLOYMENT name, not the model family name.
# Foundry portal -> your project -> Deployments.
#
# gpt-5-mini is a REASONING model. That is why every tool turn in this demo
# shows a `text_reasoning` item alongside the `function_call`: the model thinks
# before it decides which tool to call. It also means this model rejects
# temperature/top_p and uses reasoning_effort instead.
FOUNDRY_MODEL=gpt-5-mini

# AI-103 Lesson 17 -- copy to .env and fill in. Gitignored.
#
# Everything here is KEYLESS. There is no admin key and no storage key in this
# lesson, by design: the number one silent failure in Azure AI Search is a
# permissions problem that a key would have papered over, and papering over it
# is exactly what makes it un-teachable.

# ---------------------------------------------------------------------------
# The search service
# ---------------------------------------------------------------------------
# GOTCHA, and it is the big one: a search service ships with data-plane
# Microsoft Entra authentication turned OFF. In that state it accepts API keys
# and nothing else, and a perfectly valid bearer token from a user who holds
# Owner on the subscription comes back HTTP 403. Roles do not matter until the
# service is told to honor them:
#
#   az search service update -n <service> -g <rg> \
#       --auth-options aadOrApiKey --aad-auth-failure-mode http403
#
# Then assign, on the SERVICE scope, to the human who will run these scripts:
#   Search Service Contributor    -> create index, indexer, skillset, data source
#   Search Index Data Contributor -> write documents
#   Search Index Data Reader      -> query
# Owner grants NONE of these. Owner is control plane; queries are data plane.
SEARCH_ENDPOINT=https://<search-service>.search.windows.net

# The stable API version carries the whole ingestion and retrieval pipeline.
SEARCH_API_VERSION=2026-04-01

# A preview version is required for the parts of agentic retrieval that are
# still preview -- query planning with a model, answer synthesis, and
# configurable reasoning effort. On the stable version a knowledge base does
# minimal, extractive retrieval and rejects a model reference outright.
# Token-based chunking on the split skill is preview-gated the same way.
SEARCH_PREVIEW_API_VERSION=2026-05-01-preview

# ---------------------------------------------------------------------------
# Where the source content lives
# ---------------------------------------------------------------------------
# The blob indexer connects with the SEARCH SERVICE's managed identity, not
# yours. Two things must both be true:
#   1. the search service has a system-assigned identity
#        az search service update -n <service> -g <rg> --identity-type SystemAssigned
#   2. that identity holds Storage Blob Data Reader on the storage account
# Creating a second indexer changes nothing about access -- an indexer has no
# identity of its own. The grant is always to the service.
AZURE_SUBSCRIPTION_ID=<subscription-guid>
AZURE_RESOURCE_GROUP=<resource-group>
STORAGE_ACCOUNT=<storage-account-name>

# ---------------------------------------------------------------------------
# The Foundry resource that powers enrichment and vectorization
# ---------------------------------------------------------------------------
# Must be the custom-subdomain host (<name>.cognitiveservices.azure.com), NOT a
# regional endpoint. The skillset attaches this resource by SUBDOMAIN for
# identity-based billing, and a regional host has no subdomain to bind to.
#
# GOTCHA: a key-based billing attach requires the search service and this
# resource to sit in the SAME physical region, and returns
#   "Provided key isn't a valid CognitiveServices type key for the region of
#    your search service."
# when they do not. The identity-based attach used in m17_ingest.py carries no
# same-region requirement, which is the only reason a cross-region layout works
# at all. Grant the search service's identity, on this resource:
#   Cognitive Services User        -> billing attach for built-in skills
#   Cognitive Services OpenAI User -> the embedding skill and the vectorizer
FOUNDRY_RESOURCE_URI=https://<foundry-account>.cognitiveservices.azure.com

# The SAME Foundry account, reached on its OpenAI host. Beat 3b posts a
# grounded chat completion to <this>/openai/v1/chat/completions. These are
# two hostnames on one resource, not two resources -- and they are written
# out separately rather than derived by string surgery, because a derived
# hostname is a silent 404 the day the naming convention changes.
FOUNDRY_OPENAI_ENDPOINT=https://<foundry-account>.openai.azure.com

# The embedding model is declared TWICE -- once as a skill that vectorizes
# content at indexing time, once as a vectorizer that vectorizes the query. If
# the two ever drift apart, queries land in a different embedding space and
# relevance collapses with no error anywhere. One variable, used in both places.
EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Query planning for agentic retrieval. Only the gpt-4o, gpt-4.1, and gpt-5
# families are supported here -- an audio, image, or video deployment is
# rejected. This also writes the grounded answer in Beat 3.
CHAT_DEPLOYMENT=gpt-5-mini

# ---------------------------------------------------------------------------
# The Foundry project that owns the agent
# ---------------------------------------------------------------------------
# Find it with:
#   az rest --method get --url "https://management.azure.com/subscriptions/<sub>\
#     /resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/\
#     <account>/projects?api-version=2025-06-01"
PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project>

# =============================================================================
# Lesson 8 -- RAG lab configuration
# Copy to .env and fill in your own values. Keyless: no API keys go here.
# Sign in first with `az login`; the SDKs borrow that identity via Entra ID.
# =============================================================================

# Your Foundry project endpoint (Azure AI Foundry > project > Overview).
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# Your account's Azure OpenAI endpoint (the *.openai.azure.com one).
AZURE_OPENAI_ENDPOINT=https://<your-account>.openai.azure.com/

# Embeddings + chat API version.
AZURE_OPENAI_API_VERSION=2024-10-21

# Your Azure AI Search endpoint (Search service > Overview > Url).
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net

# The index this lab creates and queries.
SEARCH_INDEX_NAME=contoso-support

# Deployment names in your Foundry project.
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
CHAT_DEPLOYMENT_NAME=gpt-5-mini

# --- AI-103 Lesson 7 demo: m07_prompt_demo.py (model calls only; nothing is mutated) ---
# Copy to ".env" and fill in. Auth is keyless: run `az login` first, no API keys.

# The PROJECT endpoint (front door to the project). Foundry portal -> project -> Overview -> Endpoint.
#   https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# The model DEPLOYMENT name. Note: gpt-5-mini is a REASONING model -- it rejects temperature/top_p
# and uses reasoning_effort instead (the demo shows this). A standard model (gpt-4o-mini, gpt-4.1)
# would accept temperature; the demo adapts either way.
MODEL_DEPLOYMENT_NAME=gpt-5-mini

# =============================================================================
# Lesson 9 -- Evaluate + Observe configuration
# Copy to .env and fill in your values. Keyless: sign in with `az login`.
# =============================================================================

# Foundry project (has the chat + embedding deployments and the connections).
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# Account Azure OpenAI endpoint + API version.
AZURE_OPENAI_ENDPOINT=https://<your-account>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Search (the Lesson 8 RAG index).
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
SEARCH_INDEX_NAME=contoso-support

# Deployment names.
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
CHAT_DEPLOYMENT_NAME=gpt-5-mini

# Application Insights connection string (Foundry project telemetry sink).
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=<url>;...

# Release gate: minimum groundedness score (1-5) an answer must hit to "ship".
GROUNDEDNESS_GATE=3.0

# =============================================================================
# AI-103 Lesson 13 - Multimodal Understanding Workflows
# Copy this file to ".env" and fill in the values for YOUR Foundry account.
#   cp .env.example .env
# =============================================================================
#
# WHY ARE THERE TWO ENDPOINT HOSTS?
# ---------------------------------
# This is the single most common trip-up in Lesson 13, so read this block.
#
# One Azure resource (an AIServices-kind Foundry account) fronts BOTH of the
# services we use, but each service is reached through a DIFFERENT DNS host,
# because they are different data planes with different API surfaces:
#
#   1. Azure OpenAI data plane  -> https://<account>.openai.azure.com/openai/v1
#      Serves chat completions, including vision-enabled chat. We talk to it
#      with the plain `openai` Python package (NOT AzureOpenAI - see README).
#
#   2. Foundry / Content Understanding data plane
#                               -> https://<account>.services.ai.azure.com/
#      Serves Content Understanding analyzers. The azure-ai-contentunderstanding
#      SDK readme specifies exactly this host format.
#
# They are NOT interchangeable. Pointing the Content Understanding SDK at the
# *.openai.azure.com host, or pointing the OpenAI client at the
# *.services.ai.azure.com host, produces confusing 404s with no error body.
#
# Also note: the project-scoped form
#   https://<account>.services.ai.azure.com/api/projects/<project>
# is used by some Foundry SDKs, but for Azure OpenAI chat it returns a BARE 404
# with an empty response body. If you see an empty 404, you are on the wrong
# host or the wrong path. Verified the hard way in Lesson 12.
# =============================================================================


# --- 1. Azure OpenAI data plane (vision chat: m13_vision_chat.py) ------------
# The ACCOUNT endpoint. The scripts append /openai/v1 themselves, matching L12.
FOUNDRY_ACCOUNT_ENDPOINT=https://aif-ai103-l11-gcn5uizgywfac.openai.azure.com

# Vision-capable chat deployment. gpt-5-mini (2025-08-07) is GA and accepts
# image parts in the message content array.
CHAT_MODEL=gpt-5-mini


# --- 2. Content Understanding data plane (m13_cu_*.py) -----------------------
# MUST be the services.ai.azure.com host, with a trailing slash.
# Do NOT append /openai/v1 here.
CONTENTUNDERSTANDING_ENDPOINT=https://aif-ai103-l11-gcn5uizgywfac.services.ai.azure.com/

# GA API version for Content Understanding. 2026-06-01-preview is the current
# preview; only use a preview version for preview-only features.
CONTENTUNDERSTANDING_API_VERSION=2025-11-01


# --- 3. Analyzer + asset settings --------------------------------------------
# Custom analyzer ID created by m13_cu_analyzer.py. Analyzer IDs must be unique
# within the account; bump the suffix if you want a clean re-create.
CU_IMAGE_ANALYZER_ID=ai103L13ImageV1   # NO HYPHENS: the service rejects custom analyzerIds containing "-"

# Content Understanding custom analyzers that declare a fieldSchema require a
# completion model role. Use a deployment that exists in THIS account.
CU_COMPLETION_MODEL=gpt-5-mini

# Publicly reachable URL of a short demo video (<= 200 MB / <= 30 min for the
# direct-upload path, <= 4 GB / <= 2 h for the URL path).
CU_VIDEO_URL=

# Local image used by the vision-chat demo. A local file is the default because
# Azure OpenAI requires image URLs to be PUBLICLY accessible - base64 avoids
# that entirely. Any .jpg/.png works.
DEMO_IMAGE_PATH=./assets/shelf.jpg


# --- 4. Authentication -------------------------------------------------------
# There are NO keys in this file, and that is deliberate. Every script uses
# AzureCliCredential (keyless). Sign in once before recording:
#
#   az login
#   az account set --subscription <your-sub-id>
#
# You need these RBAC roles on the Foundry account:
#   - "Cognitive Services OpenAI User"  (vision chat)
#   - "Cognitive Services User"         (Content Understanding)
#
# Optional: pin a tenant if your az login spans multiple tenants.
# AZURE_TENANT_ID=

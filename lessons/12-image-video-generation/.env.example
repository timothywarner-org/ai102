# =============================================================================
# AI-103 Lesson 12 -- Design and implement image- and video-generation solutions
# Demos: m12_image_gen.py, m12_image_edit.py, m12_video_gen.py, m12_video_remix.py
#
# Copy to .env and fill in your values:   cp .env.example .env
#
# Keyless: sign in with `az login`. No API keys anywhere in this lesson.
# The demos authenticate with AzureCliCredential, which uses that az identity.
# =============================================================================

# -----------------------------------------------------------------------------
# READ THIS BEFORE YOU PASTE AN ENDPOINT. Lesson 12 is the one lesson in this
# course that does NOT use the Foundry *project* endpoint.
#
# Lessons 10 and 11 talk to agents, and agents are project-scoped, so they use:
#     https://<account>.services.ai.azure.com/api/projects/<project>
#
# Images and video are ACCOUNT-scoped model deployments. They are not projected
# under /api/projects/..., and asking for them there returns a bare 404 with no
# error body -- which is a miserable thing to debug, because the token is valid,
# the deployment exists, and the SDK call is correct. The path is simply wrong.
#
# Verified empirically against this account on 2026-08-11:
#
#   base_url                                                          images  video
#   ----------------------------------------------------------------  ------  -----
#   https://<acct>.services.ai.azure.com/api/projects/<proj>/openai/v1   404    404
#   https://<acct>.openai.azure.com/openai/v1                            OK     OK
#   https://<acct>.services.ai.azure.com/openai/v1                       OK     OK
#
# Both ACCOUNT hostnames work; they are two DNS names for the same account. Use
# the .openai.azure.com form below, because that is the one Microsoft Learn's
# image and video documentation shows, so your code matches the published docs.
#
# Set the bare account host here WITHOUT a trailing path. The demos append
# `/openai/v1` themselves, so there is exactly one place in the code where the
# API surface version is decided.
#
# Foundry portal -> your project -> Overview -> Endpoint, then strip everything
# from /api/projects onward and swap the host, or read it straight off the ARM
# resource:
#
#   az cognitiveservices account show -n <account> -g rg-ai103-mvp \
#     --query "properties.endpoints.\"OpenAI Sora API\"" -o tsv
#
# The account name is generated from the resource group ID, so it differs per
# rebuild. Today's account is aif-ai103-l11-gcn5uizgywfac, shared with L10/L11.
FOUNDRY_ACCOUNT_ENDPOINT=https://<account>.openai.azure.com

# The model DEPLOYMENT name, not the model family name.
# Foundry portal -> your project -> Deployments.
#
# gpt-image-2 (version 2026-04-21) is deployed here at GlobalStandard with a
# 2 RPM rate limit. Two requests per minute is not a typo -- image models are
# provisioned in requests per minute, not tokens per minute, and the default
# grant is small. If you re-run the image demos back to back you WILL hit a 429,
# so pace them or ask for more quota before you record.
IMAGE_MODEL=gpt-image-2

# Sora 2 (version 2025-12-08) at GlobalStandard, 9 RPM.
#
# Three constraints that shape what you can demo:
#   * Two concurrent jobs per account. A third create call is rejected while two
#     are still queued or in progress.
#   * Rendered videos expire after 24 hours. Download them in the same run.
#   * Content policy blocks photorealistic depictions of people and recognizable
#     IP, and rejects any reference image containing a human face. Keep demo
#     prompts on objects, landscapes, and stylized animation.
VIDEO_MODEL=sora-2

# -----------------------------------------------------------------------------
# BEAT 1 -- Content Safety harm scan + content provenance
# -----------------------------------------------------------------------------
#
# Beat 1 talks to a DIFFERENT data plane on the SAME account. The generation beats
# use https://<acct>.openai.azure.com/openai/v1 with the ai.azure.com token
# audience; Content Safety uses the .cognitiveservices.azure.com host with the
# cognitiveservices.azure.com audience. One resource, two front doors.
#
# A separate --kind ContentSafety resource is NOT required. Verified 2026-08-11:
# the AIServices Foundry account already serves both
#   POST /contentsafety/image:analyze          (GA,      api-version=2024-09-01)
#   POST /contentsafety/provenance:detect      (preview, api-version=2026-07-01-preview)
#
# Entra token auth requires the account to have a custom subdomain, which the
# lesson Bicep already sets.
CONTENT_SAFETY_ENDPOINT=https://<account>.cognitiveservices.azure.com

# The provenance API accepts a BLOB URI only -- no inline bytes, no base64. So the
# scan uploads each file, detects, then deletes the blob. That means two role
# assignments on this storage account, and they are different roles:
#
#   you                          -> Storage Blob Data Contributor  (to upload)
#   the account's managed identity -> Storage Blob Data Reader      (to read it back)
#
# Role assignments take up to 5 minutes to propagate. During that window uploads
# fail with a 403 that reads like a misconfiguration. It usually is not; wait.
STORAGE_ACCOUNT_NAME=<storage-account-name>
PROVENANCE_CONTAINER=provenance-input

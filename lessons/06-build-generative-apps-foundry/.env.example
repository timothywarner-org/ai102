# --- AI-103 Lesson 6 demo: m06_build_app_demo.py (connect, consume, connectors, agent) ---
# Copy to ".env" and fill in. Auth is keyless: run `az login` first, no API keys.

# The PROJECT endpoint -- the front door that reaches every deployment + connection.
# Foundry portal -> your project -> Overview -> Endpoint, OR:
#   https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# The model DEPLOYMENT name to consume (not the model family). Foundry -> Models + endpoints.
MODEL_DEPLOYMENT_NAME=gpt-5-mini

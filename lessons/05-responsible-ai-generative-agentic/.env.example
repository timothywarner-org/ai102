# --- AI-103 Lesson 5 demo: m05_evals_demo.py (evaluators score only; nothing is mutated) ---
# Copy to ".env" and fill in. Auth is keyless: run `az login` first, no API keys.

# The JUDGE model the quality evaluators grade with (LLM-as-a-judge).
# Foundry portal -> your project -> Overview -> Endpoint (the account services endpoint).
AZURE_OPENAI_ENDPOINT=https://<your-account>.services.ai.azure.com
# The deployment NAME to use as judge (reuse the Lesson 3 deployment).
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# API version. Bump if the gpt-5 family rejects this on your account (portal shows supported versions).
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional and DISCOURAGED: set only for a key-based lab. Leave blank to stay keyless (Entra ID).
AZURE_OPENAI_KEY=

# Optional -- only needed for the service-based safety evaluator (`--safety`).
# Leave blank to SKIP safety; the quality evaluators are the always-on core of the demo.
AZURE_AI_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

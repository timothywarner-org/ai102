# --- AI-103 Lesson 5 demo: m05_evals_demo.py (evaluators score only; nothing is mutated) ---
# Copy to ".env" and fill in. Auth is keyless: run `az login` first, no API keys.

# The JUDGE model the quality evaluators grade with (LLM-as-a-judge).
# Use the Azure OpenAI endpoint form of your Foundry account (…​.openai.azure.com).
AZURE_OPENAI_ENDPOINT=https://aif-ai103-mvp-quc6kxy2j2v2q.openai.azure.com/
# The deployment NAME to use as judge. We reuse the SAME gpt-5-mini we run the app on, so the
# lab stays a single deployment. gpt-5 wants max_completion_tokens, not max_tokens -- the demo
# passes is_reasoning_model=True (auto-detected for gpt-5 / o-series) so the evaluator adapts.
# Any modern model works; a NON-gpt-5 judge just doesn't need the flag.
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Use an api-version new enough for max_completion_tokens (gpt-5). Bump if your account rejects it.
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Force the reasoning-model dialect on/off if auto-detection ever guesses wrong (true/false).
# AZURE_OPENAI_IS_REASONING=true
# Optional and DISCOURAGED: set only for a key-based lab. Leave blank to stay keyless (Entra ID).
AZURE_OPENAI_KEY=

# Optional -- only needed for the service-based safety evaluator (`--safety`).
# Leave blank to SKIP safety; the quality evaluators are the always-on core of the demo.
AZURE_AI_PROJECT_ENDPOINT=https://aif-ai103-mvp-quc6kxy2j2v2q.services.ai.azure.com/api/projects/proj-lesson-05

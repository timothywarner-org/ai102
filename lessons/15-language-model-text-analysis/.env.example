# AI-103 Lesson 15 -- copy to .env and fill in. Gitignored.
#
# ONE Azure account (the Foundry multi-service resource) exposes all three
# surfaces used here. Confirm your hostnames with:
#   az cognitiveservices account show -n <account> -g <rg> --query properties.endpoints

# Chat + structured outputs. Scripts append /openai/v1.
FOUNDRY_ACCOUNT_ENDPOINT=https://<account>.openai.azure.com
CHAT_MODEL=gpt-5-mini

# Azure Language :analyze-text  (Beat 2, Path A)
LANGUAGE_ENDPOINT=https://<account>.cognitiveservices.azure.com

# Translator over Entra ID (Beat 3). ALL THREE are required -- see the AUTH NOTE
# at the top of m15_translate.py. Omitting the region or resource id produces a
# 401 that reads like a bad token.
TRANSLATOR_REGION=eastus2
TRANSLATOR_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>

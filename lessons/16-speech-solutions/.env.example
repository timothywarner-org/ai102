# AI-103 Lesson 16 -- copy to .env and fill in. Gitignored.
#
# ONE Azure account (the Foundry multi-service resource) exposes Speech AND
# Voice Live. No new resource is needed for this lesson. Confirm with:
#   az cognitiveservices account show -n <account> -g <rg> --query properties.endpoints

# Voice Live rides the Foundry account hostname. Scripts build the wss:// URL.
FOUNDRY_ACCOUNT_ENDPOINT=https://<account>.services.ai.azure.com

# Voice Live model. This is a MODEL NAME, not one of your deployments --
# Voice Live is fully managed and deploys nothing on your side.
VOICE_LIVE_MODEL=gpt-realtime

# Speech authenticates against the *.cognitiveservices.azure.com custom domain,
# NOT the services.ai.azure.com host used by the model APIs. Mixing them up
# produces a 401 that looks like a missing role assignment.
SPEECH_ENDPOINT=https://<account>.cognitiveservices.azure.com
SPEECH_REGION=eastus2

# Neural voice used for both the fixture generator and the TTS leg of the
# pipeline comparison. Any voice from the catalog works.
SPEECH_VOICE=en-US-AvaMultilingualNeural

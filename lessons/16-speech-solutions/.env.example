# AI-103 Lesson 16 -- copy to .env and fill in. Gitignored.
#
# ONE Foundry account carries all of this: chat, audio-in chat, Speech, and
# speech translation. Confirm hostnames with:
#   az cognitiveservices account show -n <account> -g <rg> --query properties.endpoints

# Chat and audio-in chat (Beat 3, and Beat 4 Route 2).
# The scripts append /openai/v1 to this value.
FOUNDRY_ACCOUNT_ENDPOINT=https://<account>.openai.azure.com
CHAT_MODEL=gpt-5.1

# Beat 3. An AUDIO-CAPABLE deployment.
#
# The gpt-4o-*-audio-preview family is GONE from the current catalog. Do not
# copy that name out of an older tutorial -- the deployment will simply fail.
# The successors are gpt-audio, gpt-audio-mini, and gpt-audio-1.5.
#
# Check what YOUR account offers before deploying anything:
#   az cognitiveservices account list-models -g <rg> -n <account> \
#     --query "[?contains(name,'audio')].[name,version]" -o tsv
#
# Leave blank and Beat 3 runs Path A alone and prints the deploy command.
AUDIO_MODEL=gpt-audio-mini

# Speech (Beats 2 and 4). BOTH are required.
#
# Speech has TWO surfaces with TWO token shapes:
#   regional (<region>.tts/.stt.speech.microsoft.com) -> aad#<resourceId>#<token>
#   account  (<account>.cognitiveservices.azure.com)  -> plain bearer token
# This lesson uses the regional surface, so SPEECH_RESOURCE_ID is mandatory.
# A plain bearer token there returns a 401 that reads like an expired credential.
SPEECH_REGION=eastus2
SPEECH_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>

# Used only by m16_voice_live.py, which is NOT part of the 4-beat runbook.
VOICE_LIVE_MODEL=gpt-realtime
SPEECH_ENDPOINT=https://<account>.cognitiveservices.azure.com
SPEECH_VOICE=en-US-AriaNeural
CHAT_DEPLOYMENT=gpt-5-mini

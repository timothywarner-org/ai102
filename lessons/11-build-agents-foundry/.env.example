# =============================================================================
# AI-103 Lesson 11 -- Build agents by using Foundry (multi-agent + observability)
# Demos: m11_multi_agent.py, generate_traffic.py
#
# Copy to .env and fill in your values:   cp .env.example .env
#
# Keyless: sign in with `az login`. No API keys anywhere in this lesson.
# The demos authenticate with AzureCliCredential, which uses that az identity.
# =============================================================================

# Foundry portal -> your project -> Overview -> Endpoint (the "Foundry API" one).
# Shape: https://<account>.services.ai.azure.com/api/projects/<project>
#
# Rebuilding from scratch? infra/ai103-l11-agents.bicep stands up this whole lesson
# (account + project + model + App Insights) and prints all three values below:
#
#   az group create -n rg-ai103-mvp -l eastus2
#   az deployment group create -g rg-ai103-mvp -n l11-agents \
#     -f ../../infra/ai103-l11-agents.bicep \
#     -p userObjectId=$(az ad signed-in-user show --query id -o tsv)
#
# The account name is generated from the resource group ID, so it differs per rebuild.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/proj-agents

# The model DEPLOYMENT name, not the model family name.
# Foundry portal -> your project -> Deployments.
FOUNDRY_MODEL=gpt-5-mini

# Application Insights connection string, for the observability half of this lesson.
# Azure portal -> your Application Insights resource -> Overview -> Connection String.
#
# This is a SECRET: it embeds an instrumentation key. Keep the real value in .env
# (gitignored) and never commit it. The placeholder below is intentionally fake.
#
# Without this set, m11_multi_agent.py still runs the hand-off demo and simply
# reports that tracing is off, so the lesson degrades gracefully.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<your-key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# Agent name used by generate_traffic.py against a portal-provisioned prompt agent.
TRAFFIC_AGENT=l10-support-agent

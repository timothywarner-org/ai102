# --- AI-103 Lesson 3 demo: m03_ops_demo.py (read-only monitoring; nothing is mutated) ---
# Copy to ".env" and fill in. Auth is keyless: run `az login` first, no API keys.

# LO1 -- quota headroom (control plane). Use the region that holds your deployments.
AZURE_SUBSCRIPTION_ID=<your-subscription-guid>
QUOTA_LOCATION=eastus2
# LO1 -- cost guardrails read month-to-date spend on this same subscription. No extra config;
# you need Cost Management Reader on the subscription (Reader usually suffices).

# LO2 -- Observability wiring (data plane). Foundry portal -> project -> Overview -> Endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# LO3 -- Azure AI Search index health + relevance (leave SEARCH_ENDPOINT blank to SKIP).
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
# Persistent demo index seeded by seed_index.py (see README). Both the script and the notebook read it.
SEARCH_INDEX_NAME=ai103-l03-demo
SEARCH_KEY_FIELD=id
# Optional: only if you ingest with an indexer.
SEARCH_INDEXER_NAME=
# Fallback single-query relevance signal, used only when no labeled set is provided.
SEARCH_SAMPLE_QUERY=*
# Gold query set for top-k precision: each case is a query + the ids that SHOULD rank in the top k.
# (Matches the six docs seeded into ai103-l03-demo.) Set SEARCH_TOP_K to change k (default 3).
SEARCH_TOP_K=3
SEARCH_LABELED_QUERIES=[{"query":"how do I scale model quota","expected":["quota-01"]},{"query":"budget alerts and cost per deployment","expected":["cost-01"]},{"query":"groundedness score for RAG answers","expected":["ground-01"]},{"query":"top-k precision and A/B testing relevance","expected":["relevance-01"]}]

# LO2 signal generator (m03_generate_signal.py): the model deployment to call.
MODEL_DEPLOYMENT_NAME=gpt-5-mini

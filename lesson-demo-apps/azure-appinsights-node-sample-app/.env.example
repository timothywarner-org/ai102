# Azure App Insights Node.js demo: your settings go here
# Copy this file to .env in this folder, then fill in your value.
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env

# Azure portal > your Application Insights resource > Overview > Instrumentation Key
InstrumentationKey=<your-app-insights-instrumentation-key>

# Port the demo server (server.js) listens on
PORT=3000

# Load test settings (loadtest.js). Defaults shown; change them to push more traffic.
BASE_URL=http://localhost:3000
TOTAL_REQUESTS=200
CONCURRENCY=40

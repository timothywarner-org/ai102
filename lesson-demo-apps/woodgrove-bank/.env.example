# =============================================================================
# Woodgrove Bank AI-102 demos: your settings go here
# =============================================================================
# 1. Copy this file to .env in this same folder (woodgrove-bank/.env).
#      Windows:     copy .env.example .env
#      macOS/Linux: cp .env.example .env
# 2. Fill in ONLY the sections for the demos you're running. Leave the rest blank.
# 3. Find keys and endpoints in the Azure portal: open the resource, then
#    "Keys and Endpoint" (Resource Management section).
#
# .env is in .gitignore, so your keys never get committed. Keep it that way.
# =============================================================================

# --- Text moderation via Logic App (app.js) ----------------------------------
# Your Logic App's HTTP trigger URL: Logic App designer > "When a HTTP request
# is received" > HTTP URL. It contains a SAS signature, so treat it like a key.
LOGIC_APP_URL=

# --- Groundedness detection (groundedness-api/groundedness-demo.js) ---------
# Azure AI Content Safety resource
CONTENT_SAFETY_ENDPOINT=https://<your-content-safety-resource>.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=
CONTENT_SAFETY_API_VERSION=2024-09-15-preview

# --- Image moderation, image analysis, and batch vision ----------------------
# (image-moderation-app.js, image-analysis-app.js, vision-batch-demo-app.js)
# Azure AI Vision resource
VISION_ENDPOINT=https://<your-vision-resource>.cognitiveservices.azure.com/
VISION_KEY=

# Storage for uploaded images (image-analysis-app.js)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_BLOB_CONTAINER=uploads

# Blob report (generate-blob-report.js)
AZURE_STORAGE_ACCOUNT=<your-storage-account-name>
AZURE_STORAGE_CONTAINER=demos

# --- Image metadata in Cosmos DB (infra/cosmos-smoketest.js) ----------------
COSMOS_URI=https://<your-cosmos-account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DB=woodgrovebankdb
COSMOS_CONTAINER=images
COSMOS_PARTITION_KEY=/filename

# --- Speech-to-text (speech-to-text-demo.js, speech-web-server.js) ----------
# Azure AI Speech resource
SPEECH_KEY=
SPEECH_REGION=<your-speech-region, e.g. eastus>

# --- Text-to-speech (TTS/tts-demo.js) ----------------------------------------
# Signs in with your Azure identity (run "az login" first), so no key needed.
AZURE_REGION=<your-speech-region, e.g. eastus>

# --- Video Indexer (video-indexer-ai102-demo.js) ----------------------------
# Video Indexer portal (https://www.videoindexer.ai) > Account settings.
# Access tokens expire after about an hour, so generate a fresh one per session.
VIDEO_INDEXER_REGION=eastus
VIDEO_INDEXER_ACCOUNT_ID=<your-video-indexer-account-id>
VIDEO_INDEXER_ACCESS_TOKEN=

# --- Language analysis (language-demo.js) ----------------------------------
# Azure AI Language resource
LANGUAGE_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com/
LANGUAGE_KEY=

# --- Document analysis (document-analysis-app.js) ---------------------------
# Azure AI Document Intelligence resource (the SDK still calls it Form Recognizer)
FORM_RECOGNIZER_ENDPOINT=https://<your-document-intelligence-resource>.cognitiveservices.azure.com/
FORM_RECOGNIZER_KEY=

# Rock Band Name Checker: your settings go here
# Copy this file to .env in this folder, then fill in your values.
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env

# Azure AI Content Safety resource: Azure portal > resource > Keys and Endpoint
CONTENT_SAFETY_ENDPOINT=https://<your-content-safety-resource>.cognitiveservices.azure.com/
CONTENT_SAFETY_API_KEY=

# Log Analytics workspace: Azure portal > workspace > Agents (Workspace ID and Primary key)
LOG_ANALYTICS_WORKSPACE_ID=<your-log-analytics-workspace-id>
LOG_ANALYTICS_SHARED_KEY=

# Optional: Application Insights connection string (resource > Overview > Connection String)
APP_INSIGHTS_CONNECTION_STRING=

# Optional: pull the Content Safety key from Azure Key Vault instead of this file
KEY_VAULT_URL=https://<your-key-vault>.vault.azure.net/

# Tim's Chat (Azure OpenAI chat demo): your settings go here
# Copy this file to .env in this folder, then fill in your values.
#   Windows:     copy .env.sample .env
#   macOS/Linux: cp .env.sample .env

# Azure portal > your Azure OpenAI resource > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_KEY=

# The DEPLOYMENT name you created for your chat model (not the model family name)
AZURE_OPENAI_MODEL=<your-deployment-name>

# start.cmd and start.sh open http://127.0.0.1:50505, so the server listens there
PORT=50505

# Optional branding for the chat UI
# UI_TITLE=Tim's Chat
# UI_CHAT_TITLE=Learn Azure OpenAI
# UI_CHAT_DESCRIPTION=Ask me anything about Azure OpenAI and cloud development!
# UI_LOGO=/static/assets/ttt-logo.png
